<title>Kitchen Sink</title>
<style>
/* Claude theme — Warm Serif Essay
   Ivory background, ink text, clay-orange accent, serif throughout,
   dark code blocks (Shiki owns code colors via inline styles). */
:root {
  --bg: #faf9f5;
  --ink: #2b2a26;
  --muted: #6b655c;
  --accent: #cc785c;
  --accent-strong: #a64f34;
  --rule: #e7e0d2;
  --tint: #f3ede1;
  --code-inline-bg: #efe9df;
}

* { box-sizing: border-box; }
html { -webkit-text-size-adjust: 100%; }

body.theme-claude {
  margin: 0;
  background: var(--bg);
  color: var(--ink);
  font: 18px/1.75 Georgia, 'Iowan Old Style', 'Tiempos Text', 'Times New Roman', serif;
  -webkit-font-smoothing: antialiased;
