.theme-claude h2 { font-size: 1.8rem; font-weight: 600; border-bottom: 1px solid var(--rule); padding-bottom: 0.35rem; }
.theme-claude h3 { font-size: 1.4rem; font-weight: 600; }
.theme-claude h4 { font-size: 1.15rem; font-weight: 700; }
.theme-claude p { margin: 1.1rem 0; text-wrap: pretty; }

.theme-claude a {
  color: var(--accent-strong);
