  margin: 0 auto;
  padding: 4rem 1.5rem 6rem;
}

.theme-claude .md-header { margin-bottom: 2.5rem; }
.theme-claude .md-header h1 { margin: 0; }

.theme-claude h1, .theme-claude h2, .theme-claude h3,
.theme-claude h4, .theme-claude h5, .theme-claude h6 {
  font-family: Georgia, 'Tiempos Headline', serif;
  line-height: 1.25;
  color: #1a1915;
  letter-spacing: -0.01em;
  margin: 2.4rem 0 1rem;
