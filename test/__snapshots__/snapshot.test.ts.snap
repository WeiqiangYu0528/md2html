<li class="task-list-item"><input class="task-list-item-checkbox" disabled="" type="checkbox"> todo</li>
</ul>
<h2 id="table" tabindex="-1">Table</h2>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Feature</th>
<th>Supported</th>
</tr>
</thead>
<tbody>
<tr>
<td>Tables</td>
<td>Yes</td>
</tr>
</tbody>
</table>
</div>
<h2 id="code" tabindex="-1">Code</h2>
<pre class="shiki vitesse-dark" style="background-color:#121212;color:#dbd7caee" tabindex="0"><code class="language-js"><span class="line"><span style="color:#CB7676">const</span><span style="color:#BD976A"> x</span><span style="color:#666666"> =</span><span style="color:#4C9A91"> 1</span></span>
<span class="line"><span style="color:#BD976A">console</span><span style="color:#666666">.</span><span style="color:#80A665">log</span><span style="color:#666666">(</span><span style="color:#BD976A">x</span><span style="color:#666666">)</span></span></code></pre>
<h2 id="callout" tabindex="-1">Callout</h2>
<div class="callout callout-note">
<p class="callout-title">Note</p>
<p>Remember this.</p>
</div>
<h2 id="quote" tabindex="-1">Quote</h2>
<blockquote>
<p>A wise quote.</p>
</blockquote>
<p>Text with a footnote.<sup class="footnote-ref"><a href="#fn1" id="fnref1">[1]</a></sup></p>
<hr class="footnotes-sep">
<section class="footnotes">
<ol class="footnotes-list">
