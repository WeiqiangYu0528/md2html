      "primaryBorderColor": "#4a86c5",
      "secondaryColor": "#1a2417",
      "tertiaryColor": "#1c1f23",
      "lineColor": "#9cc4f0",
      "textColor": "#e6e8eb",
      "mainBkg": "#182433",
      "nodeBorder": "#4a86c5",
      "clusterBkg": "#1c1f23",
