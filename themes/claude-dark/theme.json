  "extends": "claude",
  "shikiThemeFile": "code-theme.json",
  "fonts": [],
  "mermaid": {
    "theme": "dark",
    "themeVariables": {
      "fontFamily": "system-ui, -apple-system, 'Segoe UI', Roboto, sans-serif",
